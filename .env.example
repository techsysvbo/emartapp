# =============================================================================
# E-MART – Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# OR use the Vault sync script to auto-populate .env from HashiCorp Vault:
#
#   ./scripts/vault-sync.sh
#
# IMPORTANT: Never commit a populated .env file to source control.
# =============================================================================

# ── Node.js API ──────────────────────────────────────────────────────────────

# MongoDB connection string.
# Local dev default: mongodb://emongo:27017/epoc
# Atlas example: mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/epoc?retryWrites=true&w=majority
MONGO_URI=mongodb://emongo:27017/epoc

# Strong random secret for signing JWT tokens (min 32 chars recommended).
# Generate: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of email addresses that receive admin role on registration.
# Example: ADMIN_EMAILS=admin@yourdomain.com,ops@yourdomain.com
ADMIN_EMAILS=

# ── SMTP / Email ─────────────────────────────────────────────────────────────

# Set to "false" to disable email notifications (useful for local dev / testing).
SMTP_ENABLED=false

SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
# Use an App Password, never your account password.
SMTP_USER=
SMTP_PASS=

# ── Spring Boot / MySQL ───────────────────────────────────────────────────────

MYSQL_URL=jdbc:mysql://emartdb:3306/books?allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=books

# ── Nginx port (host-side) ────────────────────────────────────────────────────
NGINX_PORT=80

# ── Service ports (override if you have conflicts on your machine) ────────────
API_PORT=5000
WEBAPI_PORT=9000

# ── MongoDB local container ───────────────────────────────────────────────────
MONGO_INITDB_DATABASE=epoc

# ── Observability (only needed when using the observability Compose profile) ──
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
# Used by scripts/vault-sync.sh
VAULT_ADDR=https://127.0.0.1:8200
# Set to "true" only for dev/self-signed-cert environments.
VAULT_SKIP_VERIFY=false
# Vault token or AppRole credentials (see docs/VAULT.md).
VAULT_TOKEN=
# AppRole auth (preferred for non-dev environments):
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
