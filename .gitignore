# ── Secrets / environment files ──────────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Angular build output ──────────────────────────────────────────────────────
client/dist/
client/.angular/
client/node_modules/

# ── Java / Maven ──────────────────────────────────────────────────────────────
javaapi/target/
*.class
*.jar
*.war
*.ear

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

